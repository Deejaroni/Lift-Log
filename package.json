    "audit:ui": "node --no-warnings tools/ui-audit.mjs",
    "mockup": "node --no-warnings tools/mockup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "http-server": "14.1.1"
  }
}
